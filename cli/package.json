{
  "name": "restaurant-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "React Ink UI (client) + blessed-contrib Dashboard (server) for Restaurant Ordering System",
  "scripts": {
    "start": "node --import tsx/esm src/ClientApp.jsx",
    "client": "node --import tsx/esm src/ClientApp.jsx",
    "server": "node src/server_dashboard.mjs",
    "server-ink": "node --import tsx/esm src/ServerApp.jsx",
    "dev": "node --import tsx/esm --watch src/ClientApp.jsx"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
